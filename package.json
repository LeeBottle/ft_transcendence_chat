{
  "name": "ft_transcendence",
  "private": true,
  "type": "module",
  "scripts": {
    "_format:check": "prettier --check \"**/*.{js,ts,tsx,sh,json,yaml,md,html,css}\"",
    "_format:write": "prettier --write \"**/*.{js,ts,tsx,sh,json,yaml,md,html,css}\"",
    "_lint:root": "eslint \"*.{js,json}\" \"scripts/**/*.js\" \".vscode/**/*.json\"",
    "_lint:root:fix": "eslint --fix \"*.{js,json}\" \"scripts/**/*.js\" \".vscode/**/*.json\"",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "cleanup:all": "pnpm run cleanup:artifacts && pnpm run cleanup:node-modules",
    "cleanup:artifacts": "./scripts/cleanup-artifacts.sh",
    "cleanup:node-modules": "./scripts/cleanup-node-modules.sh",
    "dev": "turbo run dev",
    "fix": "turbo run //#_lint:root:fix lint:fix && turbo run //#_format:write",
    "format": "turbo run //#_format:check",
    "lint": "turbo run //#_lint:root lint",
    "prepare": "husky",
    "test": "turbo run test",
    "validate": "turbo run check-types //#_lint:root lint //#_format:check",
    "vscode:merge-settings": "node ./scripts/merge-vscode-settings.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@prettier/plugin-oxc": "^0.1.0",
    "@repo/eslint-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.7.4",
    "prettier-plugin-embed": "^0.5.1",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-sh": "^0.19.0",
    "prettier-plugin-sql": "^0.20.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.10.0",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "~24.18.0",
    "pnpm": "^11.17.0"
  },
  "volta": {
    "node": "24.18.0",
    "pnpm": "11.17.0"
  }
}

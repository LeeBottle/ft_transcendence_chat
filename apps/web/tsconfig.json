{
  "extends": "@repo/typescript-config/next-app",
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "features/**/*.ts",
    "features/**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],

  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo",
    "paths": {
      "@/*": ["./*"]
    }
  }
}

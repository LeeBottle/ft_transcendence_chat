{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "build": "next build",
    "check-types": "next typegen && tsc --noEmit",
    "dev": "wait-on tcp:4000 -t 30000 && dotenv -e ../../infra/.env.web -- next dev --turbopack -p 3000",
    "lint": "eslint \"*.{js,json}\" \"{app,components,features}/**/*.{ts,tsx}\"",
    "lint:fix": "eslint --fix \"*.{js,json}\" \"{app,components,features}/**/*.{ts,tsx}\"",
    "start": "NODE_OPTIONS=--enable-source-maps dotenv -e ../../infra/.env.web -- next start"
  },
  "dependencies": {
    "@repo/schemas": "workspace:*",
    "next": "16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "catalog:",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "catalog:",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "wait-on": "^9.0.10"
  }
}

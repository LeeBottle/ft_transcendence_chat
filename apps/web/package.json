    "@repo/types": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "catalog:",
    "nodemon": "^3.1.14",
    "typescript": "catalog:",
    "wait-on": "^9.0.10"

{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "build": "nest build",
    "check-types": "tsc --noEmit",
    "debug": "nest start --debug --watch",
    "dev": "NODE_ENV=development nest start --watch --exec 'node --watch-path=../../infra/.env.database --watch-path=../../infra/.env.api'",
    "format": "prettier --check \"src/**/*.ts\" \"*.{js,json,md}\"",
    "format:fix": "prettier --write \"src/**/*.ts\" \"*.{js,json,md}\"",
    "lint": "eslint \"src/**/*.ts\" \"*.{js,json,md}\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"*.{js,json,md}\"",
    "prod": "NODE_ENV=production node dist/main",
    "start": "nest start"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/typeorm": "^11.0.3",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "mysql2": "^3.23.0",
    "nestjs-zod": "^5.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}

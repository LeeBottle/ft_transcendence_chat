{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#*.js": {
      "types": "./src/*.ts",
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "_typeorm": "NODE_ENV=development node --conditions=development --enable-source-maps --env-file=../../infra/.env.database --import tsx node_modules/typeorm/cli.js",
    "build": "nest build",
    "check-types": "tsc --noEmit",
    "debug": "NODE_ENV=development NODE_OPTIONS=--enable-source-maps nest start --debug --watch --env-file ../../infra/.env.database --env-file ../../infra/.env.api --exec 'node --watch-path=../../infra/.env.database --watch-path=../../infra/.env.api'",
    "dev": "NODE_ENV=development NODE_OPTIONS=--enable-source-maps nest start --watch --env-file ../../infra/.env.database --env-file ../../infra/.env.api --exec 'node --watch-path=../../infra/.env.database --watch-path=../../infra/.env.api'",
    "lint": "eslint \"*.{js,json}\" \"src/**/*.ts\"",
    "lint:fix": "eslint --fix \"*.{js,json}\" \"src/**/*.ts\"",
    "migration:create": "pnpm _typeorm migration:create",
    "migration:generate": "pnpm _typeorm migration:generate -d src/database/data-source.ts",
    "migration:revert": "pnpm _typeorm migration:revert -d src/database/data-source.ts",
    "migration:run": "pnpm _typeorm migration:run -d src/database/data-source.ts",
    "migration:run:prod": "NODE_ENV=production node --enable-source-maps node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
    "prod": "NODE_ENV=production node --enable-source-maps dist/main.js",
    "reset-schema": "tsx --conditions=development --env-file ../../infra/.env.database src/database/scripts/reset-schema.ts",
    "start": "NODE_ENV=development NODE_OPTIONS=--enable-source-maps nest start --env-file ../../infra/.env.database --env-file ../../infra/.env.api"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/typeorm": "^11.0.3",
    "@repo/constants": "workspace:*",
    "@repo/schemas": "workspace:*",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.4.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.23.0",
    "nestjs-zod": "^5.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.0",
    "uuid": "^14.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "@types/passport-jwt": "^4.0.1",
    "chokidar": "^5.0.0",
    "eslint": "catalog:",
    "tsx": "^4.23.1",
    "typescript": "catalog:"
  }
}

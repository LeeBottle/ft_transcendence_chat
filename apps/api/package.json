{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "build": "nest build",
    "check-types": "tsc --noEmit",
    "debug": "nest start --debug --watch",
    "dev": "NODE_ENV=development nest start --watch --env-file ../../infra/.env.database  --exec 'node --watch-path=../../infra/.env.database --watch-path=../../infra/.env.api'",
    "lint": "eslint \"src/**/*.ts\" \"*.{js,json,md}\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"*.{js,json,md}\"",
    "migration:create": "pnpm typeorm migration:create",
    "migration:generate": "pnpm typeorm migration:generate -d src/database/data-source.ts",
    "migration:revert": "pnpm typeorm migration:revert -d src/database/data-source.ts",
    "migration:run": "pnpm typeorm migration:run -d src/database/data-source.ts",
    "prod": "NODE_ENV=production node --enable-source-maps dist/main",
    "start": "nest start",
    "typeorm": "NODE_ENV=development node --env-file=../../infra/.env.database --import tsx ./node_modules/typeorm/cli.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/typeorm": "^11.0.3",
    "@repo/schemas": "workspace:*",
    "@repo/types": "workspace:*",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "mysql2": "^3.23.0",
    "nestjs-zod": "^5.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "^4.23.1",
    "typescript": "catalog:"
  }
}

{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["*.js", "scripts/*.js"],
  "exclude": ["node_modules"]
}

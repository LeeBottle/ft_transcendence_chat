{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NODE_ENV", "NEXT_PUBLIC_*"],
      "passThroughEnv": ["API_URL"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": { "cache": false, "persistent": true },

    "check-types": {
      "inputs": [
        "**/*.{ts,tsx}",
        "tsconfig.json",
        "tsconfig.*.json",
        "!{node_modules,dist,.next,.turbo}/**",
        "!**/out/**"
      ],
      "outputs": []
    },

    "//#_lint:root": {
      "inputs": [
        "*.{js,json}",
        "scripts/**/*.{js,sh}",
        ".vscode/{extensions,settings.shared,tasks}.json"
      ],
      "outputs": []
    },
    "//#_lint:root:fix": { "cache": false },
    "lint": {
      "inputs": ["**/*.{js,ts,tsx,sh,json}", "!{node_modules,dist,.next,.turbo}/**", "!**/out/**"],
      "outputs": []
    },
    "lint:fix": { "cache": false },

    "//#_format:check": {
      "inputs": [
        "**/*.{js,ts,tsx,sh,json,yaml,md,html,css}",
        "$TURBO_ROOT$/{prettier.config.js,.prettierignore}",
        "!{node_modules,dist,.next,.turbo}/**",
        "!**/out/**"
      ],
      "outputs": []
    },
    "//#_format:write": { "cache": false }
  }
}

{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["API_URL", "CLIENT_URL", "PORT"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*", "!.env.example"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": { "cache": false, "persistent": true },

    "check-types": {
      "inputs": [
        "**/*.{ts,tsx}",
        "tsconfig.json",
        "tsconfig.*.json",
        "package.json",
        "!**/.turbo/**",
        "!**/.next/**",
        "!**/dist/**",
        "!**/out/**",
        "!**/node_modules/**"
      ]
    },

    "format": {
      "inputs": [
        "**/*.{js,ts,tsx,json,md,yaml,yml,html,css}",
        "$TURBO_ROOT$/prettier.config.js",
        "$TURBO_ROOT$/.prettierignore",
        "!**/.turbo/**",
        "!**/.next/**",
        "!**/dist/**",
        "!**/out/**",
        "!**/node_modules/**"
      ],
      "outputs": []
    },
    "//#format:root-files": {
      "inputs": [
        "*.{js,json,md,yaml,yml}",
        ".prettierignore",
        "scripts/*.{sh,js}",
        ".vscode/*.json",
        "!.vscode/settings.json",
        "!.vscode/settings.local.jsonc",
        "!pnpm-lock.yaml"
      ],
      "outputs": []
    },
    "format:fix": { "cache": false, "dependsOn": ["lint:fix"] },
    "//#format:fix:root-files": { "cache": false, "dependsOn": ["//#lint:fix:root-files"] },

    "lint": {
      "inputs": [
        "**/*.{js,ts,tsx,json,md,yaml,yml,html,css}",
        "!**/.turbo/**",
        "!**/.next/**",
        "!**/dist/**",
        "!**/out/**",
        "!**/node_modules/**"
      ],
      "outputs": []
    },
    "//#lint:root-files": {
      "inputs": [
        "*.{js,json,md,yaml,yml}",
        "scripts/*.{sh,js}",
        ".vscode/*.json",
        "!.vscode/settings.json",
        "!.vscode/settings.local.jsonc",
        "!pnpm-lock.yaml"
      ],
      "outputs": []
    },
    "lint:fix": { "cache": false },
    "//#lint:fix:root-files": { "cache": false }
  }
}

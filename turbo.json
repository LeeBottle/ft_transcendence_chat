{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NODE_ENV", "NEXT_PUBLIC_*"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": { "cache": false, "persistent": true },

    "check-types": {
      "inputs": [
        "**/*.{ts,tsx}",
        "tsconfig.json",
        "tsconfig.*.json",
        "!{node_modules,dist,.next,.turbo}/**",
        "!**/out/**"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts", "test/**/*.ts"],
      "outputs": []
    },
    "test:calendar:smoke": {
      "cache": false,
      "dependsOn": ["build", "^build"],
      "env": ["DB_HOST"],
      "inputs": ["src/**/*.ts", "test/calendar/**/*.smoke.ts"],
      "outputs": []
    },

    "//#_lint:root": {
      "inputs": [
        "*.{js,json}",
        "scripts/**/*.js",
        ".vscode/{extensions,settings.shared,tasks}.json"
      ],
      "outputs": []
    },
    "//#_lint:root:fix": { "cache": false },
    "lint": {
      "inputs": ["**/*.{js,ts,tsx,json}", "!{node_modules,dist,.next,.turbo}/**", "!**/out/**"],
      "outputs": []
    },
    "lint:fix": { "cache": false },

    "//#_format:check": {
      "inputs": [
        "**/*.{js,ts,tsx,sh,json,yaml,md,html,css}",
        "$TURBO_ROOT$/{prettier.config.js,.prettierignore}",
        "!{node_modules,dist,.next,.turbo}/**",
        "!**/out/**"
      ],
      "outputs": []
    },
    "//#_format:write": { "cache": false }
  }
}

{
  "name": "@repo/eslint-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./base": "./base.js",
    "./json": "./json.js",
    "./next-js": "./next.js",
    "./nest-app": "./nest-app.js",
    "./node-library": "./node-library.js",
    "./react-app": "./react-app.js",
    "./react-library": "./react-library.js",
    "./root": "./root.js"
  },
  "scripts": {
    "format": "prettier --check \"*.{js,json,md}\"",
    "format:fix": "prettier --write \"*.{js,json,md}\"",
    "lint": "eslint \"*.{js,json,md}\"",
    "lint:fix": "eslint --fix \"*.{js,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@eslint/json": "^2.0.1",
    "@next/eslint-plugin-next": "^16.2.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-package-json": "^1.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-turbo": "^2.7.1",
    "eslint-plugin-unicorn": "65.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.56.0"
  }
}

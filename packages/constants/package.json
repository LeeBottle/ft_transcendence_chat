{
  "name": "@repo/constants",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./user-login-history": {
      "types": "./src/auth/user-login-history.ts",
      "default": "./dist/auth/user-login-history.js"
    },
    "./calendar-task": {
      "types": "./src/calendar/calendar-task.ts",
      "default": "./dist/calendar/calendar-task.js"
    },
    "./chat-room-member": {
      "types": "./src/chat/chat-room-member.ts",
      "default": "./dist/chat/chat-room-member.js"
    },
    "./chat-room-message": {
      "types": "./src/chat/chat-room-message.ts",
      "default": "./dist/chat/chat-room-message.js"
    },
    "./chat-room-task": {
      "types": "./src/chat/chat-room-task.ts",
      "default": "./dist/chat/chat-room-task.js"
    },
    "./user": {
      "types": "./src/user/user.ts",
      "default": "./dist/user/user.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "dev": "tsup --watch",
    "lint": "eslint \"*.{js,ts,json}\" \"src/**/*.ts\"",
    "lint:fix": "eslint --fix \"*.{js,ts,json}\" \"src/**/*.ts\""
  },
  "devDependencies": {
    "@repo/build-tools": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}

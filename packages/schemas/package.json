{
  "name": "@repo/schemas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*.js": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    "./admin": {
      "types": "./src/admin/admin.schema.ts",
      "default": "./dist/admin/admin.schema.js"
    },
    "./auth": {
      "types": "./src/auth/auth.schema.ts",
      "default": "./dist/auth/auth.schema.js"
    },
    "./calendar": {
      "types": "./src/calendar/calendar.schema.ts",
      "default": "./dist/calendar/calendar.schema.js"
    },
    "./chat": {
      "types": "./src/chat/chat.schema.ts",
      "default": "./dist/chat/chat.schema.js"
    },
    "./user": {
      "types": "./src/user/user.schema.ts",
      "default": "./dist/user/user.schema.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "dev": "tsup --watch",
    "lint": "eslint \"*.{js,ts,json}\" \"src/**/*.ts\"",
    "lint:fix": "eslint --fix \"*.{js,ts,json}\" \"src/**/*.ts\""
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/build-tools": "workspace:*",
    "@repo/constants": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
